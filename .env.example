# ── Веб-интерфейс ─────────────────────────────────────────
HOST=127.0.0.1
PORT=7777
# Mini App нужен https. По умолчанию мейнфрейм сам поднимает туннель Cloudflare
# (без аккаунта, адрес меняется при перезапуске, кнопка в боте обновляется сама).
TUNNEL=cloudflared
# Если есть свой постоянный https-адрес, впиши его, туннель не запустится:
# PUBLIC_URL=https://mainframe.example.com

# ── Бот управления (создай у @BotFather) ─────────────────
BOT_TOKEN=
# Можно не заполнять: бот привяжется к тебе по коду со страницы «Система».
OWNER_TG_ID=
# Твой @username в Telegram без @: в рабочих группах мейнфрейм передаёт сообщения, где тебя упомянули
OWNER_TG_USERNAME=

# ── Telegram-аккаунт для экспериментов (chigwell/telegram-mcp) ─
# api_id и api_hash: https://my.telegram.org/apps
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
# Строка сессии: запусти scripts/telegram-login.sh и войди по QR
TELEGRAM_SESSION_STRING=

# ── Claude ────────────────────────────────────────────────
# Вход через подписку: на Mac выполни `claude auth login`. Ключ API не нужен.
# Для работы 24/7 надёжнее долгий токен подписки: выполни `claude setup-token`
# и вставь его сюда. Это официальный способ Anthropic для фоновых задач.
CLAUDE_CODE_OAUTH_TOKEN=
DISPATCH_MODEL=haiku
# WORK_MODEL=opus
# Полные права агента. Варианты: bypassPermissions, acceptEdits, default
PERMISSION_MODE=bypassPermissions

# ── Автоматика ───────────────────────────────────────────
# 1 = отправлять правки в сессию и отвечать по базе без подтверждения (если диспетчер уверен).
# Можно включать точечно для отдельных людей на странице «Люди».
AUTO_FORWARD=0
AUTO_REPLY=0

# ── Папки ────────────────────────────────────────────────
# Папка общего проекта «Мейнфрейм» (команды из бота, cron без проекта)
WORKSPACE_DIR=~/Assistant
# База знаний для ответов за тебя
KB_DIR=kb

# Расшифровка голосовых: локальный whisper.cpp (scripts/install-whisper.sh). off = выключить.
WHISPER_URL=http://127.0.0.1:8178
# Язык подсказкой (ru, en). Пусто = определять самому.
WHISPER_LANGUAGE=

# ── О владельце (всё личное живёт здесь и в папке памяти, не в коде) ──
OWNER_NAME=
# Основная валюта для итогов в «Финансах» и виджете денег (код ISO)
CURRENCY=RUB
# Твой часовой пояс (иначе берётся пояс сервера), например Europe/Moscow
OWNER_TZ=
# Одна фраза о себе для постов (что делаешь), остальное агент берёт из памяти
OWNER_ABOUT=
# Telegram-канал без @: статистика, посты, комментарии во Входящие
SOCIAL_TG_CHANNEL=
# Куда ведут посты: адрес продукта (метки utm ставятся сами) и как его называть
OFFER_URL=
OFFER_CTA=ссылка на мой продукт
# Папка общей памяти внутри WORKSPACE_DIR
MEMORY_DIR_NAME=Память

# ── Сервер и Mac (заполняют install-server.sh и install-mac.sh) ──
# Папки, которые живут на сервере; проекты вне их запускаются на Mac
SERVER_DIRS=
MAC_USER=
MAC_RUNNER=

# Короткие ответы и простые вопросы из бота идут на быструю модель, остальное на WORK_MODEL. 0 выключает.
MODEL_ROUTING=1
FAST_MODEL=claude-sonnet-5-5
# Mac, браузер (apple, computer, chrome, jev, cua) и коннекторы claude.ai подключаются только по делу. 0 подключает всё всегда.
TOOL_ROUTING=1
